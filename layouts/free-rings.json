{
  "id": "root",
  "type": "container",
  "layout": "vertical",
  "style": {
    "padding": 14,
    "spacing": 0,
    "alignment": "center",
    "background": "#0E0E10"
  },
  "children": [
    {
      "id": "header",
      "type": "container",
      "layout": "horizontal",
      "style": {
        "spacing": 6,
        "alignment": "center"
      },
      "children": [
        {
          "id": "title",
          "type": "text",
          "binding": "Codenotch",
          "style": {
            "maxLines": 1,
            "fontSize": 13,
            "fontWeight": "semibold",
            "color": "#FFFFFF"
          }
        },
        {
          "id": "dot",
          "type": "text",
          "binding": "·",
          "style": {
            "maxLines": 1,
            "fontSize": 11,
            "color": "#636366"
          }
        },
        {
          "id": "updated",
          "type": "relative_time",
          "binding": "{{updated}}",
          "style": {
            "fontSize": 11,
            "color": "#8E8E93"
          }
        }
      ]
    },
    {
      "id": "gap",
      "type": "spacer",
      "style": {
        "flex": 1
      }
    },
    {
      "id": "circles",
      "type": "container",
      "layout": "horizontal",
      "style": {
        "spacing": 4,
        "alignment": "center"
      },
      "children": [
        {
          "id": "c1",
          "type": "container",
          "layout": "vertical",
          "style": {
            "spacing": 6,
            "alignment": "center",
            "flex": 1
          },
          "children": [
            {
              "id": "c1z",
              "type": "container",
              "layout": "z-stack",
              "style": {
                "width": 60,
                "height": 60,
                "alignment": "center"
              },
              "children": [
                {
                  "id": "c1ring",
                  "type": "shape",
                  "variant": "circle",
                  "style": {
                    "size": 52,
                    "fillColor": {
                      "from": "{{s1_level}}",
                      "when": [
                        {
                          "lt": 0,
                          "value": "#0E0E10"
                        }
                      ],
                      "else": "#1C1C1E"
                    },
                    "strokeWidth": 5,
                    "strokeColor": {
                      "from": "{{s1_level}}",
                      "when": [
                        {
                          "lt": 0,
                          "value": "#0E0E10"
                        },
                        {
                          "lt": 50,
                          "value": "#30D158"
                        },
                        {
                          "lt": 80,
                          "value": "#FF9F0A"
                        }
                      ],
                      "else": "#FF453A"
                    }
                  }
                },
                {
                  "id": "c1i",
                  "type": "image",
                  "binding": "{{s1_logo}}",
                  "style": {
                    "width": 22,
                    "height": 22,
                    "contentMode": "fit"
                  }
                }
              ]
            },
            {
              "id": "c1t",
              "type": "text",
              "binding": "{{s1_pct}}",
              "style": {
                "maxLines": 1,
                "fontSize": 13,
                "fontWeight": "semibold",
                "color": "#FFFFFF",
                "alignment": "center"
              }
            }
          ]
        },
