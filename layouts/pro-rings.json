{
  "id": "root",
  "type": "container",
  "layout": "vertical",
  "style": {
    "padding": 14,
    "spacing": 0,
    "alignment": "center",
    "background": "#0E0E10"
  },
  "children": [
    {
      "id": "header",
      "type": "container",
      "layout": "horizontal",
      "style": {
        "spacing": 6,
        "alignment": "center"
      },
      "children": [
        {
          "id": "title",
          "type": "text",
          "binding": "Codenotch",
          "style": {
            "maxLines": 1,
            "fontSize": 13,
            "fontWeight": "semibold",
            "color": "#FFFFFF"
          }
        },
        {
          "id": "dot",
          "type": "text",
          "binding": "·",
          "style": {
            "maxLines": 1,
            "fontSize": 11,
            "color": "#636366"
          }
        },
        {
          "id": "updated",
          "type": "relative_time",
          "binding": "{{updated}}",
          "style": {
            "fontSize": 11,
            "color": "#8E8E93"
          }
        }
      ]
    },
    {
      "id": "gap",
      "type": "spacer",
      "style": {
        "flex": 1
      }
    },
    {
      "id": "rings",
      "type": "container",
      "layout": "horizontal",
      "style": {
        "spacing": 4,
        "alignment": "center"
      },
      "children": [
        {
          "id": "p1",
          "type": "container",
          "layout": "vertical",
          "style": {
            "spacing": 6,
            "alignment": "center",
            "flex": 1
          },
          "children": [
            {
              "id": "p1z",
              "type": "container",
              "layout": "z-stack",
              "style": {
                "width": 60,
                "height": 60,
                "alignment": "center"
              },
              "children": [
                {
                  "id": "p1r",
                  "type": "chart",
                  "variant": "pie",
                  "y": "{{s1_ring}}",
                  "labels": "{{ring_labels}}",
                  "style": {
                    "size": 54,
                    "innerRadius": 0.84,
                    "strokeWidth": 0,
                    "showLabels": false,
                    "showValues": false,
                    "colors": [
                      "#FF8A5B",
                      "#2C2C2E"
                    ]
                  }
                },
                {
                  "id": "p1i",
                  "type": "image",
                  "binding": "{{s1_logo}}",
                  "style": {
                    "width": 22,
                    "height": 22,
                    "contentMode": "fit"
                  }
                }
              ]
            },
            {
              "id": "p1t",
              "type": "text",
              "binding": "{{s1_pct}}",
              "style": {
                "maxLines": 1,
                "fontSize": 13,
                "fontWeight": "semibold",
                "color": "#FFFFFF",
