{
  "id": "root",
  "type": "container",
  "layout": "vertical",
  "style": {
    "padding": 12,
    "spacing": 0,
    "alignment": "leading",
    "background": "#0E0E10"
  },
  "children": [
    {
      "id": "g0",
      "type": "spacer",
      "style": {
        "flex": 1
      }
    },
    {
      "id": "b1",
      "type": "container",
      "layout": "horizontal",
      "style": {
        "spacing": 8,
        "alignment": "center"
      },
      "children": [
        {
          "id": "b1_logo",
          "type": "image",
          "binding": "{{s1_logo}}",
          "style": {
            "width": 16,
            "height": 16,
            "contentMode": "fit"
          }
        },
        {
          "id": "b1_col",
          "type": "container",
          "layout": "vertical",
          "style": {
            "spacing": 3,
            "alignment": "leading",
            "flex": 1
          },
          "children": [
            {
              "id": "b1_line",
              "type": "container",
              "layout": "horizontal",
              "style": {
                "spacing": 4,
                "alignment": "center"
              },
              "children": [
                {
                  "id": "b1_name",
                  "type": "text",
                  "binding": "{{s1_name}}",
                  "style": {
                    "maxLines": 1,
                    "fontSize": 10,
                    "fontWeight": "semibold",
                    "color": "#FFFFFF"
                  }
                },
                {
                  "id": "b1_pct",
                  "type": "text",
                  "binding": "{{s1_pct}}",
                  "style": {
                    "maxLines": 1,
                    "fontSize": 10,
                    "color": "#8E8E93"
                  }
                },
                {
                  "id": "b1_reset",
                  "type": "text",
                  "binding": "{{s1_reset}}",
                  "style": {
                    "maxLines": 1,
                    "fontSize": 10,
                    "color": "#8E8E93"
                  }
                },
                {
                  "id": "b1_sp",
                  "type": "spacer",
                  "style": {
                    "flex": 1
                  }
                }
              ]
            },
            {
              "id": "b1_bar",
              "type": "grid",
              "variant": "activity",
              "rows": 1,
              "columns": 50,
              "binding": "{{s1_cells}}",
              "style": {
                "height": 4,
                "cellGap": 0,
                "cellShape": "square",
                "cellCornerRadius": 0,
                "emptyColor": "#2C2C2E",
                "colorScale": {
                  "from": "{{s1_cells}}",
                  "stops": [
                    {
                      "at": 0,
                      "value": "#2C2C2E"
                    },
                    {
                      "at": 1,
                      "value": "#FF8A5B"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
