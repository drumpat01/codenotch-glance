{
  "id": "root",
  "type": "container",
  "layout": "vertical",
  "style": {
    "padding": 12,
    "spacing": 0,
    "alignment": "leading",
    "background": "#0E0E10"
  },
  "children": [
    {
      "id": "header",
      "type": "container",
      "layout": "horizontal",
      "style": {
        "spacing": 6,
        "alignment": "center"
      },
      "children": [
        {
          "id": "title",
          "type": "text",
          "binding": "Codenotch",
          "style": {
            "maxLines": 1,
            "fontSize": 13,
            "fontWeight": "semibold",
            "color": "#FFFFFF"
          }
        },
        {
          "id": "dot",
          "type": "text",
          "binding": "·",
          "style": {
            "maxLines": 1,
            "fontSize": 11,
            "color": "#636366"
          }
        },
        {
          "id": "updated",
          "type": "relative_time",
          "binding": "{{updated}}",
          "style": {
            "fontSize": 11,
            "color": "#8E8E93"
          }
        }
      ]
    },
    {
      "id": "g0",
      "type": "spacer",
      "style": {
        "flex": 1
      }
    },
    {
      "id": "r1",
      "type": "container",
      "layout": "horizontal",
      "style": {
        "spacing": 6,
        "alignment": "center"
      },
      "children": [
        {
          "id": "r1_logo",
          "type": "image",
          "binding": "{{s1_logo}}",
          "style": {
            "width": 14,
            "height": 14,
            "contentMode": "fit"
          }
        },
        {
          "id": "r1_namebox",
          "type": "container",
          "layout": "horizontal",
          "style": {
            "width": 72
          },
          "children": [
            {
              "id": "r1_name",
              "type": "text",
              "binding": "{{s1_name}}",
              "style": {
                "maxLines": 1,
                "fontSize": 11,
                "fontWeight": "semibold",
                "color": "#FFFFFF"
              }
            }
          ]
        },
        {
          "id": "r1_bar",
          "type": "text",
          "binding": "{{s1_bar}}",
          "style": {
            "maxLines": 1,
            "fontSize": 11,
            "color": "#FF8A5B"
          }
        },
        {
          "id": "r1_pct",
          "type": "text",
          "binding": "{{s1_pct}}",
          "style": {
            "maxLines": 1,
            "fontSize": 11,
            "fontWeight": "semibold",
            "color": "#FFFFFF"
          }
        },
        {
          "id": "r1_sp",
          "type": "spacer",
          "style": {
            "flex": 1
          }
        },
        {
          "id": "r1_reset",
          "type": "text",
          "binding": "{{s1_reset}}",
          "style": {
            "maxLines": 1,
